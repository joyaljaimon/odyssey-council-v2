# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional overrides (defaults in brain/src): text and Live model ids, and one Live voice per character
GEMINI_TEXT_MODEL=
GEMINI_LIVE_MODEL=
VOICE_ATHENA=
VOICE_ODYSSEUS=
VOICE_POSEIDON=
VOICE_CIRCE=
CHERT_API_KEY=
CHERT_AGENT_NUMBER=
BRAIN_URL=http://localhost:8080
STAGE_URL=http://localhost:3000
PUBLIC_BASE_URL=        # ngrok URL for webhooks and image links
# Stage page (browser) needs the brain socket URL too:
NEXT_PUBLIC_BRAIN_WS=ws://localhost:8080
NEXT_PUBLIC_AGENT_NUMBER=  # shown on the landing page
