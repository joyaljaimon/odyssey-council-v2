# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional overrides (defaults in brain/src): text and Live model ids, and one Live voice per character
GEMINI_TEXT_MODEL=
GEMINI_LIVE_MODEL=
GEMINI_TEXT_FALLBACKS=     # comma list tried when the text model is overloaded (default gemini-3.5-flash-lite,gemini-3.5-flash)
GEMINI_TEXT_TIMEOUT_MS=    # per-model time limit before falling back (default 8000)
VOICE_ATHENA=
VOICE_ODYSSEUS=
VOICE_POSEIDON=
VOICE_CIRCE=
# Chert managed line (https://app.trychert.com/skills.md). Sign in with the chert CLI; keys never go in chat.
CHERT_API_KEY=            # ftk_ project key, only for the HTTP API (texts)
CHERT_PROJECT_ID=
CHERT_AGENT_NUMBER=       # the line's number, shown on the landing page too
AGENT_NAME=odyssey-council   # LiveKit agent name chert dev dispatches; must be unique
# LiveKit: your own project (leave all three empty on a Shared plan to use Chert rooms)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STAGE_FPS=20
STAGE_BITRATE=2500000     # stage video bitrate (bits/s)
STAGE_CODEC=h264          # h264 (hardware) or vp8
STAGE_ORIENTATION=landscape # landscape (default) or portrait (fills an upright phone)
STAGE_SCALE=0.75          # stage video size = layout x this (portrait 540x960, landscape 960x540)
LIVE_SILENCE_MS=450       # how long the caller must be quiet before the character answers
BRAIN_URL=http://localhost:8080
STAGE_URL=http://localhost:3000
PUBLIC_BASE_URL=        # ngrok URL for webhooks and image links
# Stage page (browser) needs the brain socket URL too:
NEXT_PUBLIC_BRAIN_WS=ws://localhost:8080
NEXT_PUBLIC_AGENT_NUMBER=  # shown on the landing page
