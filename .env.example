# Copy to .env and fill in. Never commit .env.

# Gemini (https://aistudio.google.com/apikey). One key, or several comma-separated: when one runs out of
# quota the next is used, so a teammate's free key doubles what you can do.
GEMINI_API_KEY=
GEMINI_API_KEYS=

# ElevenLabs voices (optional, used first when set; Gemini voices and the Mac voice are the fallbacks).
# https://elevenlabs.io/app/settings/api-keys . Voices are picked from your account automatically;
# pin one with ELEVEN_VOICE_<MEMBER>=<voice id>, e.g. ELEVEN_VOICE_ZEUS=...
ELEVENLABS_API_KEY=
# ELEVEN_MODEL=eleven_flash_v2_5

# Chert line (https://app.trychert.com/skills.md). AGENT_NAME must match `chert dev --agent`.
AGENT_NAME=odyssey-council
# Your LiveKit project (leave all three empty on a Shared plan to use Chert rooms)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional tuning (defaults shown)
# SCRIPT_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash
# TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-3.8-flash-tts,gemini-2.5-flash-preview-tts
# VAD_END_MS=750        # how long the caller must pause before the Council answers
# BARGE_IN=1            # talking over the Council stops it (0 = it always finishes its answer)
# BARGE_MS=400          # how much speech (in the last 1.2 s) it takes to interrupt; raise if it stops too easily
# BARGE_MIN_RMS=0.03    # how loud that speech must be
# STAGE_FPS=15

# Only for repainting portraits (npm run portraits): Meta Muse Image key, about $0.01 an image
MODEL_API_KEY=
